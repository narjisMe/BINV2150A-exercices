@server = http://localhost:3000

### Inscription (renvoie un token, l'utilisateur est directement connecté)
# @name register
POST {{server}}/auth/register
Content-Type: application/json

{
  "email": "charlie@vinci.be",
  "password": "charlie",
  "firstName": "Charlie",
  "lastName": "Leroy"
}

### Inscription avec un email déjà utilisé -> 409
POST {{server}}/auth/register
Content-Type: application/json

{
  "email": "alice@vinci.be",
  "password": "x",
  "firstName": "Alice",
  "lastName": "Bis"
}

### Inscription avec un corps invalide -> 400
POST {{server}}/auth/register
Content-Type: application/json

{
  "email": "pas-un-email",
  "password": ""
}

### Inscription avec hachage
# @name registerS04
POST {{server}}/auth/register
Content-Type: application/json

{
  "email": "test-s04@vinci.be",
  "password": "MonTest123!",
  "firstName": "Test",
  "lastName": "Bcrypt"
}

### Connexion
# @name login
POST {{server}}/auth/login
Content-Type: application/json

{
  "email": "alice@vinci.be",
  "password": "alice"
}

### Connexion admin
# @name adminLogin
POST {{server}}/auth/login
Content-Type: application/json

{
  "email": "admin@miammiam.be",
  "password": "admin"
}

### Mauvais mot de passe -> 401
POST {{server}}/auth/login
Content-Type: application/json

{
  "email": "alice@vinci.be",
  "password": "pas-le-bon"
}

### Qui suis-je ? (nécessite un token)
GET {{server}}/auth/me
Authorization: {{login.response.body.token}}

### Sans token -> 401
GET {{server}}/auth/me

### Token forgé à la main (base64 d'un email existant)... ça passe ! À corriger plus tard dans le cours.
GET {{server}}/auth/me
Authorization: YWRtaW5AbWlhbW1pYW0uYmU=


### Connexion avec le bon mot de passe -> 200
# @name loginS04
POST {{server}}/auth/login
Content-Type: application/json

{
  "email": "test-s04@vinci.be",
  "password": "MonTest123!"
}

### Connexion avec un mauvais mot de passe -> 401
POST {{server}}/auth/login
Content-Type: application/json

{
  "email": "test-s04@vinci.be",
  "password": "mauvais"
}

### Accès avec le JWT reçu -> 200
GET {{server}}/auth/me
Authorization: {{loginS04.response.body.token}}